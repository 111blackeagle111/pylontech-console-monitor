# Copia questo file in .env e adatta i valori / Copy to .env and adjust.

# Porta seriale del cavo console sull'host. Meglio il percorso stabile in /dev/serial/by-id/
# Serial device of the console cable on the host. Prefer the stable path under /dev/serial/by-id/
PYLON_DEVICE=/dev/ttyUSB0

# GID del gruppo dialout sull'host: getent group dialout
# GID of the host dialout group: getent group dialout
DIALOUT_GID=20

# Porta della pagina web / Web page port
WEB_PORT=8765

TZ=Europe/Rome
INTERVAL=30
NOMINAL_AH=50
CUTOFF_SOC=30
